# Build and local validation
/target/
/.venv/
/validation-local/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Real deployment configuration is never committed; only reviewed examples.
/config.toml
/config.*.toml
!/config.example.toml
/config/
/etc/
/credentials/
/secrets/
*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx
*.crt
*.cert
.env
.env.*
!.env.example

# Runtime state, history, logs, backups and exports
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm
*.log
*.log.*
*.bak
*.backup
*.tar
*.tar.gz
*.tgz
*.zip
*.dump
*.sql.gz
*.enc
/backups/
/state/
/runtime/
/data/
/var/
/run/

# Local editor and deployment overrides
/.idea/
/.vscode/
*.local
*.local.*
/deploy/*.local.conf
/deploy/*.private.conf
/deploy/*.env
